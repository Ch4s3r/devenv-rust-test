#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test/.envrc" "/Users/S7AZA/IdeaProjects/personal/devenv-rust-test/.direnv"/*.rc
